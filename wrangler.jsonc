{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sos-engenharia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sos-engenharia-db",
      "database_id": "SUBSTITUIR_APOS_CRIAR_D1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "sos-engenharia-anexos"
    }
  ]
}
